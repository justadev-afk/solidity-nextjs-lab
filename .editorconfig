root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Solidity uses the same 2-space indentation as the rest of the repo.
# Keep this in sync with `tab_width` in packages/contracts/foundry.toml — `forge fmt`
# is the actual authority for *.sol, this block only helps the editor agree with it.
[*.sol]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
