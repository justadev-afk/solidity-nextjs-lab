# dependencies
node_modules/

# build output
.next/
out/
dist/
.turbo/
*.tsbuildinfo

# cache
**cache**

# generated by `next dev`/`next build`; verified that `tsc --noEmit` passes without it
next-env.d.ts

# NOTE: bun.lock is COMMITTED on purpose (CI uses --frozen-lockfile).

# env files — everything except the documented template
.env
.env.*
!.env.example

# foundry artifacts
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/
# NOTE: packages/contracts/lib/ is a git submodule (forge-std) and is NOT ignored.

# solc output from the Solidity editor extensions (VS Code "solidity" compiles to bin/).
# Not written by forge — forge uses out/ — but it appears as soon as you open a .sol file
# in the editor, and it is huge (~45 MB of *-solc-output.json for this one exercise).
packages/contracts/bin/

# editors
# .vscode/settings.json and .vscode/extensions.json ARE committed: they are what keeps
# the editor's "Format Document" in agreement with `forge fmt`, which is what CI checks.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# coverage
coverage/
lcov.info

# misc
.DS_Store
*.log
