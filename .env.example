# ---------------------------------------------------------------------------
# Copy this file twice:
#   cp .env.example .env                  # read by Bun (bun run *) and by forge
#   cp .env.example apps/web/.env.local   # read by Next.js
# ---------------------------------------------------------------------------

# --- Public (inlined into the browser bundle by Next.js) -------------------
NEXT_PUBLIC_APP_NAME="Solidity Next.js Lab"
NEXT_PUBLIC_ANVIL_RPC_URL="http://127.0.0.1:8545"
# Leave empty to keep the app local-only.
NEXT_PUBLIC_SEPOLIA_RPC_URL=""
# Optional: without it the app offers the injected wallet only (zero-config dev).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
# Optional override; otherwise the address comes from packages/abi/src/deployments.ts.
NEXT_PUBLIC_COFFEE_TIP_JAR_ADDRESS=""

# --- Server / tooling only (never inlined into the bundle) ----------------
# Anvil account #0 — PUBLICLY KNOWN test key. Local use only, never fund this.
# Never replace it with a real key in this file; use your shell env instead.
PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
SEPOLIA_RPC_URL=""
ETHERSCAN_API_KEY=""
